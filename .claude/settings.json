{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/tools/guard_production.py\"",
            "timeout": 10,
            "statusMessage": "Checking the production install"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/tools/guard_production.py\"",
            "timeout": 10,
            "statusMessage": "Checking the production install"
          }
        ]
      }
    ]
  }
}
